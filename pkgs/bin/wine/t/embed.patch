+/***********************************************************************
+ *           read_embed_dir_data
+ *
+ * List a directory of the embedded tree; entries keep their full unix
+ * names, as there is no directory to fchdir() into.
+ */
+static NTSTATUS read_embed_dir_data( struct dir_data *data, const char *path, const UNICODE_STRING *mask )
+{
+    char name[MAX_DIR_ENTRY_LEN + 1], *full;
+    unsigned int cookie = 0;
+    BOOL ret;
+
+    if (!append_unix_entry( data, ".", NULL, mask, path )) return STATUS_NO_MEMORY;
+    if (!append_unix_entry( data, "..", NULL, mask, path )) return STATUS_NO_MEMORY;
+    while (wine_embed_readdir( path, &cookie, name, sizeof(name) ))
+    {
+        if (asprintf( &full, "%s/%s", path, name ) == -1) return STATUS_NO_MEMORY;
+        ret = append_unix_entry( data, name, NULL, mask, full );
+        free( full );
+        if (!ret) return STATUS_NO_MEMORY;
+    }
+    return STATUS_SUCCESS;
+}
