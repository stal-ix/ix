--- /dev/null
+++ b/include/wine/embed.h
@@ -0,0 +1,33 @@
+/*
+ * Wine tree embedded into the executable
+ *
+ * A standalone build links the PE dlls and the data files into the wine
+ * binary itself; they show up under WINE_EMBED_ROOT, a unix path that
+ * never exists on disk. The functions are provided by the object carrying
+ * the payload and are weak here, so a regular build has none of them.
+ */
+
+#ifndef __WINE_WINE_EMBED_H
+#define __WINE_WINE_EMBED_H
+
+#include <string.h>
+#include <sys/stat.h>
+
+#define WINE_EMBED_ROOT "/@wine"
+
+/* stat() for a file or directory of the tree; -1 with errno set if absent */
+extern int wine_embed_stat( const char *path, struct stat *st ) __attribute__((weak));
+/* open a file of the tree; returns a read-only fd holding its contents */
+extern int wine_embed_open( const char *path ) __attribute__((weak));
+/* next entry name of a directory; *cookie starts at 0; returns 0 at the end */
+extern int wine_embed_readdir( const char *path, unsigned int *cookie, char *name, size_t size ) __attribute__((weak));
+/* the wineserver main, linked into the same executable */
+extern int wineserver_main( int argc, char *argv[] ) __attribute__((weak));
+
+static inline int wine_is_embed_path( const char *path )
+{
+    size_t len = sizeof(WINE_EMBED_ROOT) - 1;
+    return wine_embed_stat && !strncmp( path, WINE_EMBED_ROOT, len ) && (!path[len] || path[len] == '/');
+}
+
+#endif  /* __WINE_WINE_EMBED_H */
