+/******************************************************************************
+ *              open_embed_dir
+ *
+ * Open a directory of the embedded tree. Files of the tree are opened by
+ * the server like any other (it has the same tree), but a directory has no
+ * fd to list it: the handle wraps a placeholder, NtQueryDirectoryFile
+ * recognizes it through embed_dirs.
+ */
+static NTSTATUS open_embed_dir( HANDLE *handle, const char *unix_name, ACCESS_MASK access,
+                                OBJECT_ATTRIBUTES *attr, ULONG disposition, ULONG options )
+{
+    unsigned int status;
+    int fd;
+
+    if (disposition == FILE_CREATE) return STATUS_OBJECT_NAME_COLLISION;
+    if (disposition != FILE_OPEN && disposition != FILE_OPEN_IF) return STATUS_MEDIA_WRITE_PROTECTED;
+    if (options & FILE_DELETE_ON_CLOSE) return STATUS_CANNOT_DELETE;
+    if (options & FILE_NON_DIRECTORY_FILE) return STATUS_FILE_IS_A_DIRECTORY;
+
+    if ((fd = memfd_create( "wine-embed-dir", MFD_CLOEXEC )) == -1) return errno_to_status( errno );
+    status = wine_server_fd_to_handle( fd, access, attr->Attributes, handle );
+    if (!status && (status = add_embed_dir( *handle, fd, unix_name )))
+    {
+        NtClose( *handle );
+        *handle = 0;
+    }
+    close( fd );
+    return status;
+}
+
