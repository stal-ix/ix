+/* an open directory of the embedded tree: the handle wraps a placeholder memfd */
+struct embed_dir
+{
+    HANDLE           handle;
+    dev_t            dev;    /* identity of the placeholder, against handle reuse */
+    ino_t            ino;
+    char            *path;
+    struct dir_data *data;
+};
+
+static struct embed_dir **embed_dirs;
+static unsigned int embed_dirs_count, embed_dirs_size;
+
+static NTSTATUS add_embed_dir( HANDLE handle, int fd, const char *path )
+{
+    struct embed_dir *dir;
+    struct stat st;
+
+    if (fstat( fd, &st ) == -1) return errno_to_status( errno );
+    if (!(dir = calloc( 1, sizeof(*dir) )) || !(dir->path = strdup( path )))
+    {
+        free( dir );
+        return STATUS_NO_MEMORY;
+    }
+    dir->handle = handle;
+    dir->dev = st.st_dev;
+    dir->ino = st.st_ino;
+
+    mutex_lock( &dir_mutex );
+    if (embed_dirs_count == embed_dirs_size)
+    {
+        unsigned int size = max( 16, embed_dirs_size * 2 );
+        struct embed_dir **new_dirs = realloc( embed_dirs, size * sizeof(*new_dirs) );
+
+        if (!new_dirs)
+        {
+            mutex_unlock( &dir_mutex );
+            free( dir->path );
+            free( dir );
+            return STATUS_NO_MEMORY;
+        }
+        embed_dirs = new_dirs;
+        embed_dirs_size = size;
+    }
+    embed_dirs[embed_dirs_count++] = dir;
+    mutex_unlock( &dir_mutex );
+    return STATUS_SUCCESS;
+}
+
+/* called with dir_mutex held */
+static struct embed_dir *find_embed_dir( HANDLE handle, int fd )
+{
+    struct stat st;
+    unsigned int i;
+
+    if (!embed_dirs_count || fstat( fd, &st ) == -1) return NULL;
+    for (i = 0; i < embed_dirs_count; i++)
+        if (embed_dirs[i]->handle == handle && embed_dirs[i]->dev == st.st_dev && embed_dirs[i]->ino == st.st_ino)
+            return embed_dirs[i];
+    return NULL;
+}
+
+void close_embed_dir( HANDLE handle )
+{
+    unsigned int i;
+
+    if (!embed_dirs_count) return;
+    mutex_lock( &dir_mutex );
+    for (i = 0; i < embed_dirs_count; i++)
+    {
+        struct embed_dir *dir = embed_dirs[i];
+
+        if (dir->handle != handle) continue;
+        embed_dirs[i] = embed_dirs[--embed_dirs_count];
+        if (dir->data) free_dir_data( dir->data );
+        free( dir->path );
+        free( dir );
+        break;
+    }
+    mutex_unlock( &dir_mutex );
+}
+
+/* same as get_cached_dir_data, keeping the data in the embed_dir instead of the server cache */
+static unsigned int get_embed_dir_data( struct embed_dir *dir, struct dir_data **data_ret, int fd,
+                                        const UNICODE_STRING *mask, BOOLEAN restart_scan )
+{
+    BOOLEAN fresh_handle = !dir->data;
+    unsigned int status = STATUS_SUCCESS;
+
+    if (dir->data && restart_scan && mask && !ustring_equal( &dir->data->mask, mask ))
+    {
+        free_dir_data( dir->data );
+        dir->data = NULL;
+    }
+    if (!dir->data)
+    {
+        status = init_cached_dir_data( &dir->data, fd, mask, dir->path );
+        if (status == STATUS_NO_SUCH_FILE && !fresh_handle) status = STATUS_NO_MORE_FILES;
+    }
+    *data_ret = dir->data;
+    if (restart_scan && *data_ret) (*data_ret)->pos = 0;
+    return status;
+}
+
